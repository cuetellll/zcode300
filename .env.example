# ============================================================================
# Mahyar Gap — copy to .env for LOCAL runs only. On Railway, set these as
# service Variables (never commit .env). No file here contains real secrets.
# ============================================================================

NODE_ENV=production
# Railway injects PORT automatically — never hardcode a port in code.
# Local runs only: PORT=3000
PORT=3000

# --- Database (Railway PostgreSQL → "Connect" → DATABASE_URL) ---------------
DATABASE_URL=postgresql://user:password@host:5432/database

# --- Auth -------------------------------------------------------------------
# Access-token signing secret. REQUIRED in production, min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-value-of-at-least-32-characters
# Access token lifetime (seconds, default 15 min) — kept short by design.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh session lifetime in days (rotated on every refresh, HttpOnly cookie).
REFRESH_TOKEN_TTL_DAYS=30

# --- LiveKit (voice / video / screen share / radio audio) --------------------
# Server-side only — never exposed to the browser (browsers receive tokens).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
#
# TURN / NAT reminder: LiveKit Cloud ships a managed TURN server, so nothing
# else is needed. If you self-host LiveKit, peers behind symmetric NAT / strict
# corporate firewalls cannot connect over ICE alone — enable LiveKit's built-in
# TURN (turn:host:3478?transport=udp|tcp) or run coturn and list it under
# `turn:` in livekit.yaml. No TURN credential ever goes into this app: the
# browser only receives the room URL + a short-lived token from the server.

# --- Railway Storage Bucket (chat attachments, avatars) ----------------------
# Create a PRIVATE bucket, then reference its variables from the web service
# (Railway Variable References write exactly these names):
AWS_ENDPOINT_URL=https://<bucket-endpoint>
AWS_ACCESS_KEY_ID=<access key>
AWS_SECRET_ACCESS_KEY=<secret key>
AWS_S3_BUCKET_NAME=<bucket identifier>
AWS_DEFAULT_REGION=<region or 'auto'>
# virtual-hosted (default) | path  — set to `path` only if Credentials say so
AWS_S3_URL_STYLE=virtual-hosted

# --- Mahyar Radio ------------------------------------------------------------
# Stations are defined server-side in apps/api/src/config/radio-stations.ts.
# Client URLs are never accepted — commands use allowlisted station ids only.
RADIO_ENABLED=true
# Idle shutdown: when the last human leaves the voice room, the worker and its
# FFmpeg process are stopped after this delay (ms).
RADIO_IDLE_SHUTDOWN_MS=30000
# Maximum concurrent radio rooms (Railway-friendly default: 1).
RADIO_MAX_ACTIVE_ROOMS=1
# Kill a worker if no heartbeat arrives within this window (ms).
RADIO_HEARTBEAT_TIMEOUT_MS=45000
# Optional override for the python interpreter (the Docker image sets
# /opt/radio-venv/bin/python automatically).
# RADIO_WORKER_PYTHON=/opt/radio-venv/bin/python

# --- Misc --------------------------------------------------------------------
# Set to your deployed origin when the web app is served from another domain.
# CORS_ORIGIN=https://mahyar-gap.up.railway.app
